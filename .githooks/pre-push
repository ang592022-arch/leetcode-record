#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

run_python() {
    if command -v python >/dev/null 2>&1; then
        python "$@"
    elif command -v py >/dev/null 2>&1; then
        py -3 "$@"
    else
        echo "pre-push: Python 3 is required" >&2
        return 1
    fi
}

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: refusing remote ref deletion: $remote_ref" >&2
        exit 1
    fi
    if [ "$remote_sha" != "$zero" ]; then
        case "$remote_ref" in
            refs/heads/*)
                if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
                    echo "pre-push: refusing non-fast-forward update: $remote_ref" >&2
                    exit 1
                fi
                ;;
            *)
                if [ "$remote_sha" != "$local_sha" ]; then
                    echo "pre-push: refusing replacement of existing non-branch ref: $remote_ref" >&2
                    exit 1
                fi
                ;;
        esac
    fi
    run_python scripts/leetcode_repo.py scan --ref "$local_sha"
done

run_python scripts/leetcode_repo.py validate
run_python scripts/leetcode_repo.py generate --check
